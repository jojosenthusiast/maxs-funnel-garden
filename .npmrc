# Flat node_modules layout, no pnpm symlinks/junctions.
# Turbopack's Rust-based resolver fails to walk pnpm's junctioned
# node_modules on Windows when searching for next/package.json from
# route dirs (e.g. ./app). Hoisted linker sidesteps that entirely and
# behaves the same on Linux, macOS, and Windows for reviewer parity.
node-linker=hoisted
