# PostHog config — wired up in Phase 2. Do NOT commit real values.
# .env, .env.local, .env.development, .env.production are gitignored.

# Project API key for the browser SDK. Safe-by-design to expose client-side.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog instance host. US cloud default; change to https://eu.i.posthog.com
# for EU cloud or your self-hosted URL.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
